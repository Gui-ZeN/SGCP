rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =====================================================================
    //  HELPERS
    // =====================================================================

    function isSignedIn() {
      return request.auth != null;
    }

    // Usuário autenticado E com e-mail verificado.
    // O login do app é Google Sign-In, que sempre define email_verified == true.
    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Caminho do documento do usuário corrente na coleção `usuarios`
    // (o ID do documento é o e-mail, conforme src/hooks/useMetadata.ts).
    function userPath() {
      return /databases/$(database)/documents/usuarios/$(request.auth.token.email);
    }

    // Usuário autenticado que possui registro na coleção `usuarios`.
    function isRegistered() {
      return isSignedIn() && exists(userPath());
    }

    // Papel ("role") do usuário corrente. Só chamar após isRegistered().
    function roleOf() {
      return get(userPath()).data.role;
    }

    // Administrador: papel "Administrador" no cadastro `usuarios` (sem admin
    // bootstrap por e-mail — os admins vêm 100% da coleção `usuarios`).
    function isAdmin() {
      return isRegistered() && roleOf() == "Administrador";
    }

    // Editor: pode criar/editar/excluir dados operacionais.
    // Inclui Administrador e Analista. Visualizador é somente leitura.
    // Usuário autenticado mas SEM registro em `usuarios` NÃO é editor
    // (espelha a tela de "não autorizado" do app para contas não cadastradas).
    function isEditor() {
      return isAdmin()
        || (isRegistered() && roleOf() in ['Administrador', 'Coordenador', 'Analista']);
    }

    // Coordenador: admin regional. Pode ler logs (o escopo por região é aplicado no app).
    function isCoordenador() {
      return isRegistered() && roleOf() == "Coordenador";
    }

    // Unidade do coordenador ('colegio' | 'universidade'), denormalizada no doc
    // do usuário pelo app ao salvar (rules não cruzam nome-de-sede → região).
    // Docs antigos sem o campo contam como Colégio.
    function unidadeDoCoordenador() {
      return get(userPath()).data.get('unidade', 'colegio');
    }

    // A sede (pela região gravada no doc) pertence à unidade do coordenador?
    function sedeNaUnidadeDoCoordenador(regiao) {
      return (regiao == 'Universidade') == (unidadeDoCoordenador() == 'universidade');
    }

    // Usuário do app: verificado E provisionado (admin bootstrap ou cadastrado
    // em `usuarios`). Mais restrito que isVerifiedUser(), pois o login Google
    // não tem restrição de domínio — sem isto, qualquer conta Google poderia
    // ler dados sensíveis (entrevistas de desligamento, período de experiência).
    function isAppUser() {
      return isVerifiedUser() && (isAdmin() || isRegistered());
    }

    // Validação da requisição de vaga (criada pelo formulário público, sem login).
    // Os textos livres têm teto explícito: sem isso um POST anônimo podia mandar
    // campos gigantes (o doc só estoura em 1 MB) e encher o banco — é a única
    // escrita sem autenticação do sistema. Checagens escritas campo a campo de
    // propósito: indexação dinâmica (d[campo]) nem sempre é aceita na linguagem
    // de regras, e um erro aqui reprova o deploy inteiro.
    function isValidRequisicao() {
      let d = incoming();
      return d.cargo is string && d.cargo.size() > 0 && d.cargo.size() <= 200
        && d.sede is string && d.sede.size() <= 120
        && d.gestorSolicitante is string && d.gestorSolicitante.size() > 0 && d.gestorSolicitante.size() <= 200
        && d.status == 'pendente'
        && d.criadaEm is string && d.criadaEm.size() <= 40
        // teto de campos: bloqueia payload inflado com chaves extras
        && d.keys().size() <= 20
        && (!('setor' in d.keys()) || (d.setor is string && d.setor.size() <= 120))
        && (!('selecao' in d.keys()) || (d.selecao is string && d.selecao.size() <= 60))
        && (!('tipoContratacao' in d.keys()) || (d.tipoContratacao is string && d.tipoContratacao.size() <= 120))
        && (!('gestorEmail' in d.keys()) || (d.gestorEmail is string && d.gestorEmail.size() <= 320))
        && (!('jornada' in d.keys()) || (d.jornada is string && d.jornada.size() <= 200))
        && (!('idade' in d.keys()) || (d.idade is string && d.idade.size() <= 60))
        && (!('experiencia' in d.keys()) || (d.experiencia is string && d.experiencia.size() <= 500))
        && (!('salarioBeneficios' in d.keys()) || (d.salarioBeneficios is string && d.salarioBeneficios.size() <= 500))
        && (!('justificativa' in d.keys()) || (d.justificativa is string && d.justificativa.size() <= 2000))
        && (!('hardSkills' in d.keys()) || (d.hardSkills is string && d.hardSkills.size() <= 2000))
        && (!('softSkills' in d.keys()) || (d.softSkills is string && d.softSkills.size() <= 2000))
        && (!('responsabilidades' in d.keys()) || (d.responsabilidades is string && d.responsabilidades.size() <= 2000))
        // honeypot: humano nunca preenche; se vier, recusa no servidor também
        && !('website' in d.keys());
    }

    // Validação do documento de usuário (escrita sempre grava o objeto completo).
    function isValidUsuario() {
      let d = incoming();
      return d.get('email', '') is string
        && d.get('email', '').size() > 0
        && d.get('email', '').size() <= 320
        // .get() em vez de d.role: campo ausente ESTOURAVA a regra (deny com erro
        // críptico) em vez de reprovar de forma limpa.
        && d.get('role', '') in ['Administrador', 'Coordenador', 'Analista', 'Visualizador']
        && (!('sede' in d.keys()) || d.sede is string)
        && (!('unidade' in d.keys()) || d.unidade in ['colegio', 'universidade']);
    }

    // =====================================================================
    //  VAGAS  (dados de requisição de vaga)
    // =====================================================================
    //  Leitura: usuários do app (verificados e provisionados).
    //  A integração externa de Absenteísmo (Apps Script) lê esta coleção via
    //  service account (IAM, papel Cloud Datastore Viewer), que NÃO passa pelas
    //  regras de segurança — ver opção (a) em SECURITY_FIRESTORE_RULES.md.
    //  Escrita: apenas editores (Admin/Analista).
    match /vagas/{vagaId} {
      allow read: if isAppUser();
      // O SISTEMA é o dono do ciclo de vida (status/etapa/pausa) — inclusive das
      // vagas vindas da planilha. A sync do RH da Universidade só CRIA novas e
      // REMOVE as que sumiram (via service account, fora das rules), então não
      // reescreve o que o RH editou aqui. Editores gerenciam tudo; não-admin
      // apenas não pode FORJAR a origem (criar/mudar 'planilha-*').
      allow create: if isEditor()
        && (isAdmin() || !incoming().get('origem', '').matches('planilha-.*'));
      allow update: if isEditor()
        && (isAdmin() || incoming().get('origem', '') == existing().get('origem', ''));
      allow delete: if isEditor();
    }

    // =====================================================================
    //  COLEÇÕES ADMINISTRATIVAS  (escrita só de Administrador)
    // =====================================================================

    // Usuários e papéis. Leitura por qualquer usuário verificado porque o
    // app precisa listar `usuarios` na inicialização para descobrir o papel
    // do usuário corrente (src/hooks/useMetadata.ts). Escrita só de admin.
    match /usuarios/{email} {
      allow read: if isAppUser();
      // Coordenador gerencia usuários do Colégio, mas NUNCA mexe em Administrador
      // (não cria, não promove, não edita/exclui admin) — evita escalonar privilégio.
      // A restrição por região fica no app (usuario.sede é nome; as regras não
      // conseguem cruzar nome→região sem query).
      allow create: if (isAdmin() || (isCoordenador() && incoming().get('role', '') != 'Administrador')) && isValidUsuario();
      allow update: if (isAdmin() || (isCoordenador() && incoming().get('role', '') != 'Administrador' && existing().get('role', '') != 'Administrador')) && isValidUsuario();
      allow delete: if isAdmin() || (isCoordenador() && existing().get('role', '') != 'Administrador');
    }

    // Requisições de abertura de vaga. Criação PÚBLICA (formulário aberto do gestor,
    // sem login) com payload validado; leitura/gestão (aceitar/recusar) só do admin.
    match /requisicoes/{reqId} {
      allow create: if isValidRequisicao();
      allow read, update, delete: if isAdmin();
    }

    match /sedes/{sedeId} {
      allow read: if true; // leitura pública: o formulário de requisição (sem login) lista as sedes
      // Coordenador gerencia apenas sedes da UNIDADE dele (Colégio ou Universidade,
      // via unidade denormalizada no doc do usuário). A região está no próprio
      // documento da sede, então a trava por unidade é real (servidor).
      allow create: if isAdmin() || (isCoordenador() && sedeNaUnidadeDoCoordenador(incoming().get('regiao', '')));
      allow update: if isAdmin() || (isCoordenador() && sedeNaUnidadeDoCoordenador(existing().get('regiao', '')) && sedeNaUnidadeDoCoordenador(incoming().get('regiao', '')));
      allow delete: if isAdmin() || (isCoordenador() && sedeNaUnidadeDoCoordenador(existing().get('regiao', '')));
    }

    match /regioes/{regiaoId} {
      allow read: if isAppUser();
      allow write: if isAdmin();
    }

    match /cargos/{cargoId} {
      allow read: if isAppUser();
      allow write: if isAdmin();
    }

    match /setores/{setorId} {
      allow read: if isAppUser();
      allow write: if isAdmin();
    }

    // Configuração interna do sistema. Nenhum cliente lê isto hoje, então
    // mantemos no menor privilégio: somente Administrador lê e escreve.
    match /system_config/{configId} {
      allow read, write: if isAdmin();
    }

    // Config GLOBAL da UI (ex.: enfeites de época). Todos os usuários LEEM (pra
    // renderizar o enfeite); só Administrador escreve (liga/desliga no painel).
    match /config/{docId} {
      allow read: if isAppUser();
      allow write: if isAdmin();
    }

    // =====================================================================
    //  COLEÇÕES OPERACIONAIS  (leitura: usuário do app; escrita: editor)
    //  Contêm dados pessoais de colaboradores (entrevistas de desligamento,
    //  período de experiência etc.), por isso a leitura exige autenticação.
    // =====================================================================

    match /treinamentos/{treinamentoId} {
      allow read: if isAppUser();
      allow write: if isEditor();
    }

    match /experiencia/{experienciaId} {
      allow read: if isAppUser();
      allow write: if isEditor();
    }

    match /entrevistas/{entrevistaId} {
      allow read: if isAppUser();
      allow write: if isEditor();
    }

    match /turnover/{turnoverId} {
      allow read: if isAppUser();
      allow write: if isEditor();
    }

    // Cadastro de colaboradores (roster) — base dos aniversários. Contém dado
    // pessoal (data de nascimento), por isso leitura exige usuário do app.
    match /funcionarios/{funcionarioId} {
      allow read: if isAppUser();
      allow write: if isEditor();
    }

    // Treinamento de Integração (onboarding) — módulo da Universidade. A
    // visibilidade "só Universidade" é aplicada na UI/nav (mesma limitação de
    // unidade das vagas); aqui vale o padrão operacional.
    match /integracoes/{integracaoId} {
      allow read: if isAppUser();
      allow write: if isEditor();
    }

    // =====================================================================
    //  LOGS DE AUDITORIA  (append-only)
    //  Leitura só de Administrador (o app só assina os logs quando admin).
    //  Criação por editores (que geram os eventos). Sem update/delete para
    //  preservar a integridade da trilha de auditoria.
    // =====================================================================
    match /logs/{logId} {
      allow read: if isAdmin() || isCoordenador(); // Coordenador lê logs; o filtro por região é no app

      allow create: if isEditor()
        && incoming().usuario is string
        && incoming().acao in ['CRIOU', 'ALTEROU', 'EXCLUIU', 'SINALIZOU'];
      allow update, delete: if false;
    }

    // =====================================================================
    //  NEGAÇÃO PADRÃO  — qualquer outro caminho é bloqueado.
    // =====================================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
