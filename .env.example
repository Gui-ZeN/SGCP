# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Firebase Credentials (Vite-exposed)
# Safe to expose publicly in standard Single Page Applications
# Recommended to define in Vercel UI for production deploys
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_DATABASE_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# App Check (reCAPTCHA v3): chave do SITE (pública por natureza). Vazia = App
# Check desligado. A chave SECRETA vai só no console do Firebase, nunca aqui.
# Na Vercel o nome é RECAPTCHA_SITE_KEY (vite.config.ts aceita os dois).
VITE_RECAPTCHA_SITE_KEY=

# API de Calendários RH (read-only, Fase 1). Se VITE_CALENDARIO_API_URL ficar
# vazio, o widget "Próximas datas" some (nada quebra). A chave fica no bundle —
# use uma chave de LEITURA (dados públicos de feriados). Região padrão: CE/Fortaleza.
VITE_CALENDARIO_API_URL=
VITE_CALENDARIO_API_KEY=
VITE_CALENDARIO_UF=CE
VITE_CALENDARIO_MUNICIPIO_IBGE=2304400

# As chaves entre sistemas (28/10/2026) — só no servidor (`api/`), NUNCA com
# VITE_. Uma chave por sistema que CHAMA; o mesmo valor, com o mesmo nome, em
# toda Vercel onde mora (só Production). Mapa no vault: "Integrações e Segredos".
#   CHAVE_SGPC       a que o SGPC MANDA ao Chromos (absenteísmo e quadro).
#   CHAVE_CROMOS     a que o SGPC CONFERE em /api/vagas-externas (abandono).
#   CHAVE_ORKESTRIA  a que o SGPC CONFERE em /api/vagas-externas (desligamento).
# 32 caracteres ou mais (curta vale como ausente); as três DIFERENTES (iguais: 503).
# Troca sem queda: <NOME>_ANTERIOR com o valor velho vale junto, até apagar.
CROMOS_ABSENTEISMO_URL=
CHAVE_SGPC=
CHAVE_CROMOS=
CHAVE_ORKESTRIA=
CHAVE_CROMOS_ANTERIOR=
CHAVE_ORKESTRIA_ANTERIOR=

